{
  "name": "ddd.api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "license": "MIT",
  "private": false,
  "main": "index.js",
  "scripts": {
    "rim": "rimraf dist",
    "build": "nest build",
    "build:lib": "rimraf dist/libs/ddd && tsc -p ./libs/ddd/tsconfig.lib.json && sh ./copy.sh",
    "release:lib": "cd dist/libs/ddd && npm publish --access public",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:lib": "jest --testPathPattern=libs/ddd --coverage --coveragePathIgnorePatterns=node_modules",
    "test:cov:lib:html": "jest --testPathPattern=libs/ddd --coverage --coveragePathIgnorePatterns=node_modules --coverageReporters=text --coverageReporters=html --coverageReporters=lcov",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/devtools-integration": "^0.2.1",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjslatam/ddd-lib": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-request-context": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "libs/ddd/src/**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.entity.ts",
      "!**/*.interface.ts",
      "!**/*.mock.ts",
      "!**/*.spec.ts",
      "!**/*.test.ts",
      "!**/main.ts",
      "!**/index.ts",
      "!**/node_modules/**",
      "!**/helpers/**",
      "!**/valueobjects/**",
      "!**/aggregate-root.ts",
      "!**/domain-event.ts",
      "!**/enum.ts",
      "!**/tracking-state-manager.ts",
      "!**/valueobject.ts",
      "!**/ddd.service.ts",
      "!**/ddd.module.ts",
      "!**/types.d.ts"
    ],
    "coverageDirectory": "./coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/coverage/",
      "\\.spec\\.ts$",
      "\\.test\\.ts$"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "lcov",
      "json"
    ],
    "coverageThreshold": {
      "libs/ddd/src/core/business-rules/impl/property-change/notify-property-changed.base.ts": {
        "branches": 85,
        "functions": 100,
        "lines": 95,
        "statements": 95
      },
      "libs/ddd/src/core/business-rules/impl/property-change/reflection-type-extensions.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 85,
        "statements": 90
      },
      "libs/ddd/src/core/business-rules/impl/property-change/notify-property-changed.context.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/core/business-rules/impl/property-change/notify-property-changed.context-args.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/core/business-rules/impl/broken-rule.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/core/business-rules/impl/broken-rules-extension.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/broken-rules.manager.ts": {
        "branches": 90,
        "functions": 94,
        "lines": 97,
        "statements": 97
      },
      "libs/ddd/src/validator-rule.manager.ts": {
        "branches": 90,
        "functions": 68,
        "lines": 89,
        "statements": 87
      },
      "libs/ddd/src/core/validator-rules/impl/abstract-rule-validator.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/core/tracking-state/impl/nested-property-change-detector.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/core/tracking-state/impl/tracking-props.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/core/tracking-state/impl/tracking-state-transition.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/core/validator-rules/impl/abstract-validator.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/core/validator-rules/impl/entity-validator.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "libs/ddd/src/core/validator-rules/impl/value-object-validator.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@nestjslatam/ddd-lib(|/.*)$": "<rootDir>/libs/ddd/src/$1"
    }
  },
  "engines": {
    "node": ">=20.11"
  }
}
